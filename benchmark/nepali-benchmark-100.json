    { "id": "rural-08", "cat": "rural", "text": "भुइँमा गोबर लगाए बाली राम्रो हुन्छ।" },
    { "id": "rural-09", "cat": "rural", "text": "दाउरा र खरानी जम्मा गर्नुपर्यो।" },
    { "id": "rural-10", "cat": "rural", "text": "पशुपालनले गरिबी कम गर्न मद्दत गर्छ।" },

