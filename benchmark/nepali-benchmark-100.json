    { "id": "rural-04", "cat": "rural", "text": "पहाडमा बाली राम्रो हुँदैन यसपालि।" },
    { "id": "rural-05", "cat": "rural", "text": "खेतमा पानी चाहियो, नत्र बाली मर्नेछ।" },
