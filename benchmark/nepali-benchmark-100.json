  "sentences": [
    { "id": "conv-01", "cat": "conversational", "text": "नमस्ते! तपाईं कस्तो हुनुहुन्छ?" },
    { "id": "conv-02", "cat": "conversational", "text": "म ठिक छु, तिमी सकिएकी छौ?" },
    { "id": "conv-03", "cat": "conversational", "text": "आज धेरै बाढी भयो, घरमै बसौं न।" },
    { "id": "conv-04", "cat": "conversational", "text": "के छ साथी! ल चिया पिउने हो?" },
    { "id": "conv-05", "cat": "conversational", "text": "मलाई एकछिन बस्न दिनुस्, म आउँछु।" },
    { "id": "conv-06", "cat": "conversational", "text": "तिमी जाने हो कि बस्ने हो?" },
    { "id": "conv-07", "cat": "conversational", "text": "हजुर, अहिले नै गरिदिन्छु।" },
    { "id": "conv-08", "cat": "conversational", "text": "होइन, त्यो भन्दा अघि कुरा थियो।" },
    { "id": "conv-09", "cat": "conversational", "text": "म बुझेँ, तर एकछिन रोकिनुस्।" },
    { "id": "conv-10", "cat": "conversational", "text": "ल भइहाल्छ, हिजो जस्तो नहोऊ।" },

    { "id": "ktm-01", "cat": "kathmandu", "text": "काठमाडौंको बाटो आज धेरै जाम छ।" },
    { "id": "ktm-02", "cat": "kathmandu", "text": "म आज काठमाडौं जाँदैछु।" },
    { "id": "ktm-03", "cat": "kathmandu", "text": "बासन्तपुर जाने हो कि ललितपुर?" },
    { "id": "ktm-04", "cat": "kathmandu", "text": "यो ठाउँमा चिया पसल धेरै छ।" },
    { "id": "ktm-05", "cat": "kathmandu", "text": "तपाईंको नेपाली कति राम्रो छ!" },
    { "id": "ktm-06", "cat": "kathmandu", "text": "हामी थानमा भेटौंला, हुन्छ?" },
    { "id": "ktm-07", "cat": "kathmandu", "text": "असारमा मनाइने जात्रा राम्रो हुन्छ।" },
    { "id": "ktm-08", "cat": "kathmandu", "text": "यो सफ्टवेयरले हाम्रो काम सजिलो बनाउँछ।" },
    { "id": "ktm-09", "cat": "kathmandu", "text": "वेबसाइट अपडेट गर्नुपर्यो कि?" },
    { "id": "ktm-10", "cat": "kathmandu", "text": "आज बिहानैदेखि पानी परिरहेको छ।" },

    { "id": "rural-01", "cat": "rural", "text": "हाम्रो गाउँमा धेरै गाई र भैंसी छन्।" },
