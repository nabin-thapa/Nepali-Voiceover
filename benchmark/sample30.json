  "sentences": [
    {
      "id": "conv-01",
      "cat": "conversational",
      "text": "नमस्ते! तपाईं कस्तो हुनुहुन्छ?"
    },
    {
      "id": "conv-05",
      "cat": "conversational",
      "text": "मलाई एकछिन बस्न दिनुस्, म आउँछु।"
    },
    {
      "id": "conv-09",
      "cat": "conversational",
      "text": "म बुझेँ, तर एकछिन रोकिनुस्।"
    },
    {
      "id": "ktm-03",
      "cat": "kathmandu",
      "text": "बासन्तपुर जाने हो कि ललितपुर?"
    },
    {
      "id": "ktm-07",
      "cat": "kathmandu",
      "text": "असारमा मनाइने जात्रा राम्रो हुन्छ।"
    },
    {
      "id": "rural-01",
      "cat": "rural",
      "text": "हाम्रो गाउँमा धेरै गाई र भैंसी छन्।"
    },
    {
      "id": "rural-05",
      "cat": "rural",
      "text": "खेतमा पानी चाहियो, नत्र बाली मर्नेछ।"
    },
    {
      "id": "rural-09",
      "cat": "rural",
      "text": "दाउरा र खरानी जम्मा गर्नुपर्यो।"
    },
    {
      "id": "animal-03",
      "cat": "animal",
      "text": "आज भैंसी नदीको किनारमा घाँस चरिरहेको छ।"
    },
    {
      "id": "animal-07",
      "cat": "animal",
      "text": "घोडा छिटो दौडिन्छ खुलेको मैदानमा।"
    },
    {
      "id": "every-03",
      "cat": "everyday",
      "text": "आज बिहान चिया बनाएँ।"
    },
    {
      "id": "every-07",
      "cat": "everyday",
      "text": "बजारमा तरकारी किन्न जाने हो।"
    },
    {
      "id": "cons-01",
      "cat": "consonants",
      "text": "टाढाको टुँडी ठूलो थियो।",
      "focus": "ट/ठ"
    },
    {
      "id": "cons-05",
      "cat": "consonants",
      "text": "देउराली र धौलागिरी दुवै उच्च छन्।",
      "focus": "द/ध"
    },
    {
      "id": "nasal-01",
      "cat": "nasal",
      "text": "गाउँ र घाँस राम्रो छ।"
    },
    {
      "id": "nasal-05",
      "cat": "nasal",
      "text": "मन शान्त छ, चिन्ता छैन।"
    },
    {
      "id": "conj-03",
      "cat": "conjunct",
      "text": "त्रिशूल र श्रद्धा महत्त्वपूर्ण छन्।",
      "focus": "त्र/श्र"
    },
    {
      "id": "conj-07",
      "cat": "conjunct",
      "text": "द्वारबाट प्रवेश गर्नुहोस्।",
      "focus": "द्व/प्र"
    },
    {
      "id": "type-q-03",
      "cat": "question",
      "text": "किन यसरी भन्नुभयो?"
    },
    {
      "id": "type-x-02",
      "cat": "exclamation",
      "text": "अरे बाप रे!"
    },
    {
      "id": "type-l-02",
      "cat": "long",
      "text": "यदि तपाईंले समयमा काम सक्नुभएन भने, हामीलाई अघि बताइदिनुहोस् ताकि हामी योजना परिवर्तन गर्न सकौं।"
    },
    {
      "id": "type-s-03",
      "cat": "short",
      "text": "धन्यवाद!"
    },
    {
      "id": "num-04",
      "cat": "numbers",
      "text": "बीस मिनेटमा आउँछु।"
    },
    {
      "id": "date-03",
      "cat": "dates",
      "text": "सन्देश मिति दुई हजार छब्बीस साल असार पन्ध्र गते पठाइएको छ।"
    },
    {
      "id": "name-04",
      "cat": "names",
      "text": "लुम्बिनी बुद्धको जन्मस्थल हो।"
    },
    {
      "id": "mix-04",
      "cat": "mixed",
      "text": "Google मा search गर्नुस्।"
    },
    {
      "id": "hard-03",
      "cat": "hard",
      "text": "परियोजना सूचना अन्तर्गत निर्माण भएको छ।"
    },
    {
      "id": "hard-07",
      "cat": "hard",
      "text": "हिमालयको उचाइ र खाडीको गहिराइ चकित पार्छ।"
    }
  ]
}