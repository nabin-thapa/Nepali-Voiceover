{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:pronunciation": "tsx scripts/test-pronunciation.ts",
    "test:audio": "tsx scripts/test-audio.ts",
    "benchmark": "tsx scripts/benchmark-run.ts",
    "benchmark:nepali": "tsx scripts/benchmark-nepali.ts",
    "benchmark:compare": "tsx scripts/benchmark-compare.ts",
    "benchmark:kala": "tsx scripts/benchmark-kala.ts",
    "system:check": "tsx scripts/system-check.ts",
    "compare:reference": "tsx scripts/compare-gemini-fish.ts",
    "dataset:validate": "tsx scripts/dataset-validate.ts"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
